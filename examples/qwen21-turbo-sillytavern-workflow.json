{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "qwen_image_2.1_turbo_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {"title": "Load Qwen Image 2.1 Turbo (diffusion model)"}
  },
  "2": {
    "class_type": "QwenImage21Cache",
    "inputs": {
      "model": ["1", 0],
      "device": "auto",
      "dtype": "default"
    },
    "_meta": {"title": "Qwen Image 2.1 Cache"}
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
      "type": "qwen_image",
      "device": "default"
    },
    "_meta": {"title": "Load Text Encoder (type must be qwen_image)"}
  },
  "4": {
    "class_type": "TextEncodeQwenImage21",
    "inputs": {
      "clip": ["3", 0],
      "prompt": "%prompt%",
      "negative_prompt": "%negative_prompt%",
      "resolution": 1024
    },
    "_meta": {"title": "Text Encode Qwen Image 2.1 (required, not CLIPTextEncode)"}
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "%width%",
      "height": "%height%",
      "batch_size": 1
    },
    "_meta": {"title": "Empty Latent Image"}
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["2", 0],
      "positive": ["4", 0],
      "negative": ["4", 1],
      "latent_image": ["5", 0],
      "seed": "%seed%",
      "steps": "%steps%",
      "cfg": "%scale%",
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1
    },
    "_meta": {"title": "KSampler (standard node is fine)"}
  },
  "7": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
    },
    "_meta": {"title": "Load VAE (Qwen Image 2.1 VAE)"}
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["6", 0],
      "vae": ["7", 0]
    },
    "_meta": {"title": "VAE Decode"}
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["8", 0],
      "filename_prefix": "SillyTavern/Qwen21Turbo"
    },
    "_meta": {"title": "Save Image"}
  }
}
